{
  "manifest_version": 3,
  "name": "Vintendo Squad AI Mock Test Harness",
  "version": "1.0.0",
  "key": "",
  "action": {"default_popup":"popup.html"},
  "background":{"service_worker":"background.js"},
  "permissions":["storage","tabs","downloads","clipboardWrite"],
