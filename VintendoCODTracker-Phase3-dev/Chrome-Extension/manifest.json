{
  "manifest_version": 3,
  "name": "Vintendo Squad AI",
  "version": "1.0.3",
  "description": "Local Squad Night job queue and manual Meta AI handoff for Vintendo COD Tracker.",
  "key": "",
  "action": {
    "default_title": "Vintendo Squad AI",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "tabs", "downloads", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
