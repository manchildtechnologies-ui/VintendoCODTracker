# Create a Discord application and bot, then keep these values private.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Optional announcements target; required only when enabling automatic posts.
DISCORD_CHANNEL_ID=

# Minimum polling interval is 300 seconds. Posting remains disabled by default.
CODMUNITY_POLL_INTERVAL=900
AUTO_POST_MATCHES=false

# Relative paths are resolved from the bot folder when launched by the .cmd file.
BOT_DATABASE=data/bot.sqlite3
BOT_CARD_DIR=data/cards
# Optional local exports: <root>/<CODMunity-UID>/{profile.json,local.json,matches.json}
CODMUNITY_LOCAL_DATA_ROOT=
